@@ -0,0 +1,23 @@
+using System;
+using Multiplayer.Common;
+using Verse;
+
+namespace Multiplayer.Client;
+
+public static class RimTogetherRecovery
+{
+    private static ConnectionBase connection;
+    private static AutoRecoveryBudget budget = new();
+
+    public static bool TryBeginAutoRecovery(double seconds)
+    {
+        if (Environment.GetEnvironmentVariable("RIMTOGETHER_FAST_RESYNC") != "1" ||
+            Multiplayer.session == null || Multiplayer.session.isHost || Multiplayer.LocalServer != null || Multiplayer.arbiterInstance) return false;
+        if (connection != Multiplayer.Client)
+        { connection = Multiplayer.Client; budget = new AutoRecoveryBudget(); }
+        if (connection == null || Multiplayer.IsReplay || connection.State != ConnectionStateEnum.ClientPlaying) return false;
+        if (budget.TryAcquire(seconds)) return true;
+        Log.Warning("RimTogether: repeated desync; automatic recovery disabled for this connection. Report retained; manual resync remains available.");
+        return false;
+    }
+}

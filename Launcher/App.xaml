<Application x:Class="RimTogether.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml"><Application.Resources>
<SolidColorBrush x:Key="Surface" Color="#192329"/>
<Style TargetType="TextBox"><Setter Property="Background" Value="#111B20"/><Setter Property="Foreground" Value="#E9F0ED"/><Setter Property="CaretBrush" Value="#A9E4B5"/><Setter Property="BorderBrush" Value="#42545B"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="PasswordBox"><Setter Property="Background" Value="#111B20"/><Setter Property="Foreground" Value="#E9F0ED"/><Setter Property="BorderBrush" Value="#42545B"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#263A42"/><Setter Property="Foreground" Value="#E9F0ED"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="#57717A" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#B7E8B9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#14232A"/></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#14232A"/></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D5DFDC"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D5DFDC"/><Setter Property="FontSize" Value="14"/></Style>
</Application.Resources></Application>

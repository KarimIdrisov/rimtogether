<Window x:Class="RimTogether.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RimTogether" Width="1080" Height="860" MinWidth="850" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
<Grid Background="{StaticResource Canvas}"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#EEEEF2" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="24,30"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource Accent}" HorizontalAlignment="Left"><TextBlock Text="R" FontSize="30" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="RimTogether" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,4"/><TextBlock Text="Ваша колония. Вместе." Foreground="{StaticResource Secondary}" FontSize="12"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,40,0,0"><TextBlock Text="Этот компьютер" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Role" SelectedIndex="0" SelectionChanged="Role_Changed"><ComboBoxItem Content="Хост"/><ComboBoxItem Content="Друг"/></ComboBox><TextBlock Text="Хост хранит мир. Друг подключается к нему через Radmin." Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,12,0,0" LineHeight="19"/></StackPanel>
<StackPanel Grid.Row="3"><TextBlock x:Name="VersionLabel" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,0,0,12"/><Button Content="Логи и сохранения" Click="OpenData_Click" Background="Transparent" Padding="0,8"/><TextBlock Text="Для двух игроков" Foreground="{StaticResource Secondary}" FontSize="11" Margin="0,12,0,0"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="34,28,34,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Одна колония.&#10;Два игрока." FontSize="31" FontWeight="SemiBold" LineHeight="37"/><TextBlock x:Name="Summary" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,10,0,0"/></StackPanel><Button Grid.Column="1" Content="Обновления" Click="Update_Click" VerticalAlignment="Top" Margin="14,0,0,0" Background="White"/></Grid>
<Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><Grid Margin="0,0,0,18"><TextBlock Text="Подключение" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="InviteButton" Content="Пригласить друга" Click="Invite_Click" FontSize="12" MinHeight="30" Padding="10,6"/><Button x:Name="ImportButton" Content="Вставить приглашение" Click="Import_Click" FontSize="12" MinHeight="30" Padding="10,6"/></StackPanel></Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Ваш ник" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Username" AutomationProperties.Name="Твой ник" ToolTip="3–15 латинских букв, цифр или _"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Radmin IP хоста" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HostAddress" AutomationProperties.Name="Radmin IP хоста"/></StackPanel>
<StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0"><TextBlock Text="Общий пароль" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="ServerPassword" AutomationProperties.Name="Пароль сервера"/></StackPanel></Grid></StackPanel></Border>
<Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Игра и колония" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="Папка RimWorld" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="Выбрать" DockPanel.Dock="Right" Click="BrowseGame_Click" Margin="10,0,0,0"/><TextBox x:Name="GamePath" AutomationProperties.Name="Папка RimWorld"/></DockPanel>
<TextBlock Text="Сохранение хоста" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/><DockPanel><Button Content="Выбрать" DockPanel.Dock="Right" Click="BrowseReplay_Click" Margin="10,0,0,0"/><TextBox x:Name="ReplayPath" AutomationProperties.Name="Начальная колония"/></DockPanel>
<Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Обычный запуск продолжает текущий мир.&#10;Для смены колонии загрузите выбранный ZIP." Foreground="{StaticResource Secondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Grid.Column="1" Content="Загрузить этот сейв" Click="LoadSelectedSave_Click" FontSize="12"/></Grid></StackPanel></Border>
<StackPanel Grid.Row="3"><CheckBox x:Name="AutoUpdate" Content="Подготавливать Multiplayer перед запуском" IsChecked="True"/><CheckBox x:Name="FastRecovery" Content="Автоматически восстанавливать синхронизацию" IsChecked="True"/><TextBlock x:Name="RecoveryModeHint" Text="После загрузки хоста — одна полная точка на паузе. Продолжение вручную." Foreground="{StaticResource Secondary}" FontSize="11" Margin="0,6,0,8"/><Expander Header="Управление сервером"><StackPanel Orientation="Horizontal" Margin="0,10,0,4"><Button x:Name="StartButton" Content="Запустить сервер" Click="StartServer_Click" Margin="0,0,8,0"/><Button x:Name="StopButton" Content="Остановить" Click="StopServer_Click" IsEnabled="False"/></StackPanel></Expander></StackPanel>

<Expander Grid.Row="5" Header="Журнал работы"><TextBox x:Name="LogBox" FontFamily="Consolas" FontSize="11" IsReadOnly="True" Height="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White" Margin="0,10,0,0" AutomationProperties.Name="Журнал работы"/></Expander>
</Grid></ScrollViewer><Grid Grid.Row="1" Margin="34,16,34,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Всё готово к началу" Foreground="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Grid.Column="1" x:Name="PlayButton" Content="Запустить и подключиться" Click="Play_Click" Style="{StaticResource PrimaryButton}" Padding="24,13" FontSize="14"/></Grid></Grid></Grid></Window>

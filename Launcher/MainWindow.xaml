<Window x:Class="RimTogether.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RimTogether • RimWorld вдвоём" Width="930" Height="830" MinWidth="760" MinHeight="680" Background="#0C151A" Foreground="#EBF1ED" FontFamily="Segoe UI" Closing="Window_Closing">
<Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="RIMTOGETHER" FontSize="29" FontWeight="Bold" Foreground="#B7E8B9"/><TextBlock Text="Ваша колония. Два игрока. Одна версия." FontSize="15" Margin="0,4,0,14"/><TextBlock x:Name="Summary" Text="Multiplayer 0.11.5 • UDP 30502 • Radmin VPN" Foreground="#91A7AA" Margin="0,0,0,14"/></StackPanel>
<Border Grid.Row="1" Background="{StaticResource Surface}" Padding="18" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,16,12"><TextBlock Text="Роль на этом компьютере" Margin="0,0,0,5"/><ComboBox x:Name="Role" SelectedIndex="0" Padding="8" SelectionChanged="Role_Changed"><ComboBoxItem Content="Хост — сервер у меня"/><ComboBoxItem Content="Друг — подключаюсь к хосту"/></ComboBox></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="Твой ник • 3–15 латинских букв, цифр или _" Margin="0,0,0,5"/><TextBox x:Name="Username" AutomationProperties.Name="Твой ник"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,0,16,12"><TextBlock Text="Radmin IP хоста" Margin="0,0,0,5"/><TextBox x:Name="HostAddress" AutomationProperties.Name="Radmin IP хоста"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="Общий пароль сервера • от 6 символов" Margin="0,0,0,5"/><PasswordBox x:Name="ServerPassword" AutomationProperties.Name="Пароль сервера"/></StackPanel>
<StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12"><TextBlock Text="Папка RimWorld" Margin="0,0,0,5"/><DockPanel><Button DockPanel.Dock="Right" Content="Выбрать…" Click="BrowseGame_Click" Margin="8,0,0,0"/><TextBox x:Name="GamePath" AutomationProperties.Name="Папка RimWorld"/></DockPanel></StackPanel>
<StackPanel Grid.Row="3" Grid.ColumnSpan="2"><TextBlock Text="Начальная колония хоста • MP ZIP, используется при первом запуске сервера" Margin="0,0,0,5"/><DockPanel><Button DockPanel.Dock="Right" Content="Выбрать…" Click="BrowseReplay_Click" Margin="8,0,0,0"/><TextBox x:Name="ReplayPath" AutomationProperties.Name="Начальная колония"/></DockPanel></StackPanel>
</Grid></Border>
<StackPanel Grid.Row="2" Margin="0,14,0,8"><CheckBox x:Name="AutoUpdate" Content="Автоматически проверять и устанавливать совместимый Multiplayer перед игрой" IsChecked="True"/><CheckBox x:Name="FastRecovery" Content="Быстрый синк друга: одна автоматическая попытка восстановления" IsChecked="True" Margin="0,8,0,0"/><TextBlock x:Name="RecoveryModeHint" Text="Хост: свежая точка при входе и десинке; периодические перезагрузки мира отключены." Margin="0,8,0,0"/><TextBlock Text="Guard: проверки мира включены. Повторный десинк останавливает автоматику; ручной синк остаётся доступен." FontSize="12" Foreground="#91A7AA" Margin="0,6,0,0"/></StackPanel>
<WrapPanel Grid.Row="3" Margin="0,4,0,6"><Button x:Name="PlayButton" Content="Запустить и подключиться" FontWeight="Bold" Background="#B7E8B9" Foreground="#11241B" Click="Play_Click"/><Button x:Name="StartButton" Content="Запустить сервер" Click="StartServer_Click"/><Button x:Name="StopButton" Content="Остановить сервер" Click="StopServer_Click" IsEnabled="False"/><Button Content="Проверить обновления" Click="Update_Click"/><Button Content="Скопировать приглашение" Click="Invite_Click"/><Button Content="Вставить приглашение" Click="Import_Click"/><Button Content="Логи и бэкапы" Click="OpenData_Click"/></WrapPanel>
<Border Grid.Row="4" Background="#101E24" BorderBrush="#263A42" BorderThickness="1" CornerRadius="6"><TextBox x:Name="LogBox" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Журнал работы"/></Border>
<TextBlock Grid.Row="5" x:Name="Status" Text="Готово. Выбери роль и папку игры." Foreground="#B7E8B9" Margin="0,12,0,0"/>
</Grid></Window>

<Window x:Class="RimTogether.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RimTogether" Width="540" Height="400" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
<Grid Margin="38,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal"><Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource Accent}"><TextBlock Text="R" Foreground="White" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="RimTogether" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,28,0,0"><TextBlock x:Name="Heading" Text="Готовим вашу колонию" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Detail" Text="Проверяем обновления" Foreground="{StaticResource Secondary}" Margin="0,8,0,0" MaxHeight="52" TextTrimming="CharacterEllipsis"/></StackPanel>
<StackPanel Grid.Row="2" VerticalAlignment="Center"><ProgressBar x:Name="Progress" Height="5" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#E5E5EA" BorderThickness="0"/><TextBlock x:Name="Numbers" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,12,0,0"/><TextBlock x:Name="Reuse" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenCurrent" Content="Открыть установленную" Click="OpenCurrent_Click" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="Retry" Content="Повторить" Click="Retry_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click"/></StackPanel>
</Grid></Window>

--- /dev/null
+++ b/Source/Common/RecoveryPolicy.cs
@@ -0,0 +1,21 @@
+namespace Multiplayer.Common;
+
+// Pure policy shared by the client and regression tests. No simulation state is repaired here.
+public static class RecoveryPolicy
+{
+    public static bool ShouldUpload(bool simulating, bool replay, bool localServer, bool arbiter, bool dedicatedHost) =>
+        !simulating && !replay && (localServer || arbiter || dedicatedHost);
+}
+
+public sealed class AutoRecoveryBudget
+{
+    private double? previous;
+    public bool CircuitOpen { get; private set; }
+    public bool TryAcquire(double seconds)
+    {
+        if (CircuitOpen) return false;
+        if (previous is { } last && seconds - last < 180)
+        { CircuitOpen = true; return false; }
+        previous = seconds; return true;
+    }
+}

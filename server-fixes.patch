diff --git a/Source/Common/HostStartupSnapshot.cs b/Source/Common/HostStartupSnapshot.cs
new file mode 100644
index 0000000..e5cbc0b
--- /dev/null
+++ b/Source/Common/HostStartupSnapshot.cs
@@ -0,0 +1,79 @@
+using System;
+using System.Threading.Tasks;
+
+namespace Multiplayer.Common;
+
+// One full, paused base per host load. No age/periodic refresh policy lives here.
+public sealed class HostStartupSnapshot(MultiplayerServer server)
+{
+    private TaskCompletionSource<bool> ready = NewGate();
+    private ServerPlayer? host;
+    private bool loaded;
+    private int requestId;
+    public bool Ready { get; private set; }
+    public bool PauseRequired => server.IsStandaloneServer && !Ready;
+    private static TaskCompletionSource<bool> NewGate() => new(TaskCreationOptions.RunContinuationsAsynchronously);
+
+    public void BeginLoading(ServerPlayer player)
+    {
+        if (!server.IsStandaloneServer || !player.IsHost) return;
+        requestId = 0;
+        server.worldData.AbortJoinPointCreation();
+        if (ready.Task.IsCompleted) ready = NewGate();
+        host = player; loaded = false; requestId = 0; Ready = false;
+        ServerLog.Log("HOST SNAPSHOT: waiting for host load/replay; world remains paused");
+    }
+
+    public void WorldReady(ServerPlayer player)
+    {
+        if (!server.IsStandaloneServer || !player.IsHost || host != player || loaded) return;
+        loaded = true;
+        server.commands.PauseAll();
+        Tick();
+    }
+
+    public void Tick()
+    {
+        if (!server.IsStandaloneServer || Ready || !loaded || host == null || requestId != 0 || ready.Task.IsCompleted) return;
+        if (!host.IsPlaying || host.status != PlayerStatus.Playing || host.simulating || host.frozen) return;
+        if (!server.worldData.TryStartJoinPointCreation(true)) return;
+        requestId = server.worldData.PendingJoinPointId;
+        ServerLog.Log("HOST SNAPSHOT: creating one fresh full point after host load; id=" + requestId);
+    }
+
+    public void Committed(int id)
+    {
+        if (requestId == 0 || requestId != id) return;
+        requestId = 0; Ready = true;
+        ready.TrySetResult(true);
+        ServerLog.Log("HOST SNAPSHOT READY: fresh full base committed; world stays paused until manual resume");
+    }
+
+    public void Aborted(int id)
+    {
+        if (requestId == 0 || requestId != id) return;
+        requestId = 0; ready.TrySetResult(false);
+        ServerLog.Error("HOST SNAPSHOT FAILED: cached history retained; reconnect host to retry. World remains paused.");
+    }
+
+    public void Disconnected(ServerPlayer player)
+    {
+        if (!server.IsStandaloneServer || !player.IsHost) return;
+        host = null; loaded = false; requestId = 0; Ready = false;
+        if (ready.Task.IsCompleted) ready = NewGate();
+        server.commands.PauseAll();
+    }
+
+    public async Task WaitUntilReady()
+    {
+        if (!server.IsStandaloneServer || Ready) return;
+        var timeout = Task.Delay(TimeSpan.FromMinutes(5));
+        while (!Ready)
+        {
+            var gate = ready.Task;
+            if (await Task.WhenAny(gate, timeout) != gate)
+                throw new TimeoutException("Fresh host snapshot is not ready. Load the host first and retry joining.");
+            if (!await gate) throw new InvalidOperationException("Fresh host snapshot failed; cached history was not used for guest entry. Reconnect host.");
+        }
+    }
+}

+    public void TickJoinPointTimeout(int netTimer)
+    {
+        if (!CreatingJoinPoint || netTimer - joinPointStartedAt < JoinPointTimeoutTicks) return;
+        ServerLog.Error("Joinpoint timed out; retaining previous snapshot and complete command history.");
+        AbortJoinPointCreation();
+    }
+
+    public bool CanAcceptSnapshot(int requestId) =>
+        CreatingJoinPoint ? requestId == PendingJoinPointId : savedGame == null && requestId == 0;
+
+    public bool CommitSnapshot(int requestId, Dictionary<int, byte[]> maps, byte[] world, byte[] sessions)
+    {
+        if (!CanAcceptSnapshot(requestId)) return false;
+        if (world == null || world.Length == 0 || sessions == null || maps == null || maps.Values.Any(v => v == null || v.Length == 0))
+            throw new ArgumentException("Incomplete world upload");
+        SnapshotCompression.Validate(world);
+        SnapshotCompression.Validate(sessions, allowEmpty: true);
+        foreach (var map in maps.Values) SnapshotCompression.Validate(map);
+        mapData = maps; savedGame = world; sessionData = sessions;
+        if (CreatingJoinPoint) EndJoinPointCreation();
+        return true;
+    }
 }

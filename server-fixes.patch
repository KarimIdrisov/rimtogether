diff --git a/Source/Common/BulkDownloads.cs b/Source/Common/BulkDownloads.cs
new file mode 100644
index 0000000..c6dcb25
--- /dev/null
+++ b/Source/Common/BulkDownloads.cs
@@ -0,0 +1,140 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Net;
+using System.Net.Sockets;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Multiplayer.Common;
+
+public sealed class BulkOffer
+{
+    public string Token;
+    public string Hash;
+    public int Length;
+    public int Port;
+}
+
+public sealed class BulkDownloadServer : IDisposable
+{
+    private sealed class Entry { public IPAddress Address; public byte[] Data; public long Created; }
+    private readonly Dictionary<string, Entry> offers = new();
+    private readonly List<TcpListener> listeners = new();
+    private readonly HashSet<TcpClient> clients = new();
+    private readonly Action<string> log;
+    private bool disposed;
+    private const int MaxBytes = ConnectionBase.MaxFragmentPacketTotalSize - 6;
+
+    public BulkDownloadServer(IEnumerable<IPEndPoint> endpoints, Action<string> logger)
+    {
+        log = logger;
+        try
+        {
+            foreach (var endpoint in endpoints)
+            {
+                var listener = new TcpListener(endpoint); listener.Start(8); listeners.Add(listener);
+                _ = Accept(listener);
+            }
+        }
+        catch { Dispose(); throw; }
+    }
+    public int Port => ((IPEndPoint)listeners[0].LocalEndpoint).Port;
+    public BulkOffer Offer(IPAddress address, byte[] data)
+    {
+        if (data.Length == 0 || data.Length > MaxBytes) throw new InvalidDataException("Invalid bulk snapshot size");
+        var nonce = new byte[32]; using (var random = RandomNumberGenerator.Create()) random.GetBytes(nonce);
+        var token = Hex(nonce);
+        lock (offers)
+        {
+            foreach (var old in offers.Where(kv => Stopwatch.GetTimestamp() - kv.Value.Created > 30L * Stopwatch.Frequency).Select(kv => kv.Key).ToArray()) offers.Remove(old);
+            if (disposed || offers.Count >= 4) throw new IOException("Bulk transfer queue unavailable");
+            offers.Add(token, new Entry { Address = address, Data = data, Created = Stopwatch.GetTimestamp() });
+        }
+        return new BulkOffer { Token = token, Length = data.Length, Hash = Hash(data), Port = Port };
+    }
+    public void Revoke(string token) { lock (offers) offers.Remove(token); }
+    public static string Hex(byte[] bytes) => BitConverter.ToString(bytes).Replace("-", "");
+    public static string Hash(byte[] bytes) { using var hash = SHA256.Create(); return Hex(hash.ComputeHash(bytes)); }
+    private async Task Accept(TcpListener listener)
+    {
+        while (!disposed)
+        {
+            TcpClient client;
+            try { client = await listener.AcceptTcpClientAsync().ConfigureAwait(false); }
+            catch (Exception error) when (error is SocketException || error is ObjectDisposedException) { return; }
+            lock (clients)
+            {
+                if (disposed || clients.Count >= 4) { client.Close(); continue; }
+                clients.Add(client);
+            }
+            _ = Task.Run(() => Serve(client));
+        }
+    }
+    private void Serve(TcpClient client)
+    {
+        try
+        {
+            client.NoDelay = true; client.ReceiveTimeout = 5000; client.SendTimeout = 5000;
+            client.SendBufferSize = 4 * 1024 * 1024;
+            using var stream = client.GetStream();
+            var token = Encoding.ASCII.GetString(ReadExactly(stream, 64));
+            Entry entry;
+            lock (offers)
+            {
+                if (!offers.TryGetValue(token, out entry) ||
+                    !entry.Address.Equals(((IPEndPoint)client.Client.RemoteEndPoint).Address) ||
+                    Stopwatch.GetTimestamp() - entry.Created > 30L * Stopwatch.Frequency) return;
+                offers.Remove(token); // One use, bound to the authenticated UDP peer's IP.
+            }
+            var watch = Stopwatch.StartNew();
+            var length = BitConverter.GetBytes(entry.Data.Length); stream.Write(length, 0, length.Length);
+            for (var offset = 0; offset < entry.Data.Length; offset += 65536)
+                stream.Write(entry.Data, offset, Math.Min(65536, entry.Data.Length - offset));
+            stream.Flush();
+            log($"BULK TCP: {entry.Data.Length} bytes written in {watch.ElapsedMilliseconds}ms");
+        }
+        catch (Exception error) when (error is IOException || error is SocketException || error is ObjectDisposedException)
+        { if (!disposed) log("BULK TCP interrupted: " + error.Message); }
+        finally { lock (clients) clients.Remove(client); client.Close(); }
+    }
+    public static byte[] ReadExactly(Stream stream, int length, Action<int> progress = null)
+    {
+        var bytes = new byte[length]; int offset = 0;
+        while (offset < length)
+        {
+            var count = stream.Read(bytes, offset, Math.Min(65536, length - offset));
+            if (count == 0) throw new EndOfStreamException("Incomplete TCP snapshot");
+            offset += count; progress?.Invoke(offset);
+        }
+        return bytes;
+    }
+    public static byte[] Download(IPEndPoint endpoint, BulkOffer offer, Action<int> progress, CancellationToken cancellation = default)
+    {
+        if (offer.Length <= 0 || offer.Length > MaxBytes || offer.Token?.Length != 64 || offer.Hash?.Length != 64)
+            throw new InvalidDataException("Invalid TCP offer");
+        using var client = new TcpClient(AddressFamily.InterNetwork);
+        using var cancelRegistration = cancellation.Register(() => client.Close());
+        client.NoDelay = true; client.ReceiveTimeout = 5000; client.SendTimeout = 5000; client.ReceiveBufferSize = 4 * 1024 * 1024;
+        var connect = client.ConnectAsync(endpoint.Address, endpoint.Port);
+        if (!connect.Wait(2000)) throw new IOException("TCP connect timed out; UDP fallback requested");
+        using var stream = client.GetStream();
+        var token = Encoding.ASCII.GetBytes(offer.Token); stream.Write(token, 0, token.Length);
+        var length = BitConverter.ToInt32(ReadExactly(stream, 4), 0);
+        if (length != offer.Length) throw new InvalidDataException("TCP snapshot length mismatch");
+        var data = ReadExactly(stream, length, progress);
+        if (!Hash(data).Equals(offer.Hash, StringComparison.OrdinalIgnoreCase)) throw new InvalidDataException("TCP snapshot SHA256 mismatch");
+        return data;
+    }
+    public void Dispose()
+    {
+        disposed = true;
+        foreach (var listener in listeners) listener.Stop();
+        lock (clients) foreach (var client in clients) client.Close();
+        lock (offers) offers.Clear();
+    }
+}

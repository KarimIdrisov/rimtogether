new file mode 100644
index 0000000..7819f0f
--- /dev/null
+++ b/Source/Common/SnapshotCompression.cs
@@ -0,0 +1,26 @@
+using System.IO;
+using System.IO.Compression;
+
+namespace Multiplayer.Common;
+
+public static class SnapshotCompression
+{
+    // Validate the gzip stream before replacing the authority cache. Discard output in bounded buffers.
+    public static void Validate(byte[] data, bool allowEmpty = false)
+    {
+        if (data == null) throw new InvalidDataException("Missing compressed snapshot");
+        if (allowEmpty && data.Length == 0) return;
+        if (data.Length < 18 || data[0] != 0x1f || data[1] != 0x8b) throw new InvalidDataException("Truncated compressed snapshot");
+        using var input = new MemoryStream(data, false);
+        using var gzip = new GZipStream(input, CompressionMode.Decompress);
+        var buffer = new byte[81920]; long total = 0; int read;
+        while ((read = gzip.Read(buffer, 0, buffer.Length)) != 0)
+        {
+            total += read;
+            if (total > 512L * 1024 * 1024) throw new InvalidDataException("Expanded snapshot exceeds safety limit");
+        }
+        var footer = data.Length - 4;
+        uint expected = (uint)(data[footer] | data[footer + 1] << 8 | data[footer + 2] << 16 | data[footer + 3] << 24);
+        if ((uint)total != expected || !allowEmpty && total == 0) throw new InvalidDataException("Incomplete compressed snapshot footer");
+    }
+}

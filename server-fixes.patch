+using System.Threading;
+
+namespace Multiplayer.Common;
+
+public sealed class ServerLoopContext(MultiplayerServer server) : SynchronizationContext
+{
+    public override void Post(SendOrPostCallback callback, object? state) => server.Enqueue(() => callback(state));
+    public override SynchronizationContext CreateCopy() => this;
+}

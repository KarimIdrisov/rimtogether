--- /dev/null
+++ b/Source/Common/SyncVerificationWatchdog.cs
@@ -0,0 +1,17 @@
+namespace Multiplayer.Common;
+
+// Counts completed local opinion windows, not wall time: loading and a paused simulation
+// cannot trip the watchdog simply because no simulation data is being produced.
+public sealed class SyncVerificationWatchdog
+{
+    public const int MaxUnverifiedOpinions = 30;
+    private int unverified;
+
+    public void Matched() => unverified = 0;
+
+    public bool ObserveLocal(bool comparisonRequired, bool simulating)
+    {
+        if (!comparisonRequired || simulating) { unverified = 0; return false; }
+        return ++unverified >= MaxUnverifiedOpinions;
+    }
+}
